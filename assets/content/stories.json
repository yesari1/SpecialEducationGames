[
  {
    "id": "teeth",
    "free": true,
    "title": {
      "tr": "Dişlerimi fırçalıyorum",
      "en": "I brush my teeth"
    },
    "cover": "assets/stories/teeth/cover.png",
    "pages": [
      {
        "line": {
          "text": {
            "tr": "İşte Ali! Uyku vakti geldi.",
            "en": "Here is Leo! It's bedtime."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p1.mp3",
            "en": "assets/audio/en/stories/teeth/p1.mp3"
          }
        },
        "image": "assets/stories/teeth/page1.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Ali banyoya gitti, diş fırçasını aldı.",
            "en": "Leo went to the bathroom and picked up his toothbrush."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p2.mp3",
            "en": "assets/audio/en/stories/teeth/p2.mp3"
          }
        },
        "image": "assets/stories/teeth/page2.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Fırçaya macunu sürdük. Şimdi ne yapacağız?",
            "en": "The toothpaste is on the brush. What do we do now?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p3.mp3",
            "en": "assets/audio/en/stories/teeth/p3.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/teeth/choice_brush.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, dişlerimizi fırçalıyoruz.",
                "en": "Yes, we brush our teeth."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/teeth/p3_brush.mp3",
                "en": "assets/audio/en/stories/teeth/p3_brush.mp3"
              }
            }
          },
          {
            "image": "assets/stories/teeth/choice_bed.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Önce dişlerimizi fırçalayalım, sonra yatarız.",
                "en": "Let's brush our teeth first, then we go to bed."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/teeth/p3_bed.mp3",
                "en": "assets/audio/en/stories/teeth/p3_bed.mp3"
              }
            }
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Ali dişlerini yavaş yavaş fırçalıyor. Aşağı, yukarı.",
            "en": "Leo brushes his teeth nice and slow. Up and down."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p4.mp3",
            "en": "assets/audio/en/stories/teeth/p4.mp3"
          }
        },
        "image": "assets/stories/teeth/page4.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Fırçalamayı bitirdik. Sırada ne var?",
            "en": "All done brushing. What comes next?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p5.mp3",
            "en": "assets/audio/en/stories/teeth/p5.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/teeth/choice_rinse.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, ağzımızı suyla çalkalıyoruz.",
                "en": "Yes, we rinse our mouth with water."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/teeth/p5_rinse.mp3",
                "en": "assets/audio/en/stories/teeth/p5_rinse.mp3"
              }
            }
          },
          {
            "image": "assets/stories/teeth/choice_shoes.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Önce ağzımızı suyla çalkalayalım.",
                "en": "First, let's rinse our mouth with water."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/teeth/p5_shoes.mp3",
                "en": "assets/audio/en/stories/teeth/p5_shoes.mp3"
              }
            }
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Dişleri pırıl pırıl oldu! Ali nasıl hissediyor?",
            "en": "His teeth are sparkling clean! How does Leo feel?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p6.mp3",
            "en": "assets/audio/en/stories/teeth/p6.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/teeth/choice_happy.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, Ali çok mutlu.",
                "en": "Yes, Leo is very happy."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/teeth/p6_happy.mp3",
                "en": "assets/audio/en/stories/teeth/p6_happy.mp3"
              }
            }
          },
          {
            "image": "assets/stories/teeth/choice_sad.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Bak, Ali gülümsüyor. Ali çok mutlu.",
                "en": "Look, Leo is smiling. Leo is very happy."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/teeth/p6_sad.mp3",
                "en": "assets/audio/en/stories/teeth/p6_sad.mp3"
              }
            }
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Ali yatağına girdi. İyi geceler Ali!",
            "en": "Leo climbed into bed. Good night, Leo!"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/teeth/p7.mp3",
            "en": "assets/audio/en/stories/teeth/p7.mp3"
          }
        },
        "image": "assets/stories/teeth/page7.jpg"
      }
    ],
    "praise": {
      "text": {
        "tr": "Aferin sana! Ali'ye çok güzel yardım ettin.",
        "en": "Well done! You were a great help to Leo."
      },
      "audio": {
        "tr": "assets/audio/tr/stories/teeth/praise.mp3",
        "en": "assets/audio/en/stories/teeth/praise.mp3"
      }
    }
  },
  {
    "id": "angry",
    "free": true,
    "title": {
      "tr": "Kızınca ne yaparım?",
      "en": "What can I do when I'm angry?"
    },
    "cover": "assets/stories/angry/cover.png",
    "pages": [
      {
        "line": {
          "text": {
            "tr": "Ali ile kardeşi Elif arabayla oynuyorlar.",
            "en": "Leo and his little sister Elif are playing with a toy car."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p1.mp3",
            "en": "assets/audio/en/stories/angry/p1.mp3"
          }
        },
        "image": "assets/stories/angry/page1.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Elif, arabayı Ali'nin elinden aldı.",
            "en": "Elif took the car out of Leo's hands."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p2.mp3",
            "en": "assets/audio/en/stories/angry/p2.mp3"
          }
        },
        "image": "assets/stories/angry/page2.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Sence Ali şimdi ne hissediyor?",
            "en": "How do you think Leo feels now?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p3.mp3",
            "en": "assets/audio/en/stories/angry/p3.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/angry/choice_angry.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, Ali çok kızdı.",
                "en": "Yes, Leo is angry."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/angry/p3_angry.mp3",
                "en": "assets/audio/en/stories/angry/p3_angry.mp3"
              }
            }
          },
          {
            "image": "assets/stories/angry/choice_happy.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Ali'nin yüzüne bir bak. Ali kızdı.",
                "en": "Take a look at Leo's face. Leo is angry."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/angry/p3_happy.mp3",
                "en": "assets/audio/en/stories/angry/p3_happy.mp3"
              }
            }
          },
          {
            "image": "assets/stories/angry/choice_sad.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Ali'nin yüzüne bir bak. Ali kızdı.",
                "en": "Take a look at Leo's face. Leo is angry."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/angry/p3_sad.mp3",
                "en": "assets/audio/en/stories/angry/p3_sad.mp3"
              }
            }
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Ali çok kızdı. Elinde de bir oyuncak var.",
            "en": "Leo is really angry. He has a toy in his hand."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p4.mp3",
            "en": "assets/audio/en/stories/angry/p4.mp3"
          }
        },
        "image": "assets/stories/angry/page4.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Ali ne yapsın?",
            "en": "What should Leo do?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p5.mp3",
            "en": "assets/audio/en/stories/angry/p5.mp3"
          }
        },
        "retry": {
          "text": {
            "tr": "Başka ne yapabilir?",
            "en": "What else could he do?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p5_retry.mp3",
            "en": "assets/audio/en/stories/angry/p5_retry.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/angry/choice_throw.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Oyuncak yere düştü. Elif çok üzüldü.",
                "en": "The toy fell on the floor. Elif is very sad."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/angry/p5_throw.mp3",
                "en": "assets/audio/en/stories/angry/p5_throw.mp3"
              }
            },
            "resultImage": "assets/stories/angry/result_throw.jpg"
          },
          {
            "image": "assets/stories/angry/choice_tell.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, Ali annesine gidip kızdığını söylüyor.",
                "en": "Yes, Leo goes to Mom and tells her he is angry."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/angry/p5_tell.mp3",
                "en": "assets/audio/en/stories/angry/p5_tell.mp3"
              }
            }
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Ali annesine \"Çok kızgınım!\" dedi. Birlikte derin bir nefes aldılar.",
            "en": "Leo told Mom, \"I'm really angry!\" They took a deep breath together."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p6.mp3",
            "en": "assets/audio/en/stories/angry/p6.mp3"
          }
        },
        "image": "assets/stories/angry/page6.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Elif arabayı geri verdi. Sırayla oynadılar.",
            "en": "Elif gave the car back. They took turns playing."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/angry/p7.mp3",
            "en": "assets/audio/en/stories/angry/p7.mp3"
          }
        },
        "image": "assets/stories/angry/page7.jpg"
      }
    ],
    "praise": {
      "text": {
        "tr": "Aferin sana! Ali'ye çok güzel yardım ettin.",
        "en": "Well done! You were a great help to Leo."
      },
      "audio": {
        "tr": "assets/audio/tr/stories/angry/praise.mp3",
        "en": "assets/audio/en/stories/angry/praise.mp3"
      }
    }
  },
  {
    "id": "turn",
    "free": false,
    "title": {
      "tr": "Sıramı bekliyorum",
      "en": "I wait for my turn"
    },
    "cover": "assets/stories/turn/cover.png",
    "pages": [
      {
        "line": {
          "text": {
            "tr": "Ali parka geldi. Kaydırağı çok seviyor.",
            "en": "Leo is at the park. He loves the slide."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p1.mp3",
            "en": "assets/audio/en/stories/turn/p1.mp3"
          }
        },
        "image": "assets/stories/turn/page1.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Elif kaydırağın merdiveninde. Şimdi o kayacak.",
            "en": "Elif is on the slide ladder. It's her turn now."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p2.mp3",
            "en": "assets/audio/en/stories/turn/p2.mp3"
          }
        },
        "image": "assets/stories/turn/page2.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Ali de kaymak istiyor. Ne yapmalı?",
            "en": "Leo wants to slide too. What should he do?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p3.mp3",
            "en": "assets/audio/en/stories/turn/p3.mp3"
          }
        },
        "retry": {
          "text": {
            "tr": "Başka ne yapabilir?",
            "en": "What else could he do?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p3_retry.mp3",
            "en": "assets/audio/en/stories/turn/p3_retry.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/turn/choice_line.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, Ali, Elif'in arkasında sırasını bekliyor.",
                "en": "Yes, Leo waits for his turn behind Elif."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/turn/p3_line.mp3",
                "en": "assets/audio/en/stories/turn/p3_line.mp3"
              }
            }
          },
          {
            "image": "assets/stories/turn/choice_pull.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Elif merdivenden düştü. Canı yandı, ağlıyor.",
                "en": "Elif fell off the ladder. She got hurt and she is crying."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/turn/p3_pull.mp3",
                "en": "assets/audio/en/stories/turn/p3_pull.mp3"
              }
            },
            "resultImage": "assets/stories/turn/result_pull.jpg"
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Ali sırasını bekliyor. Bir, iki, üç...",
            "en": "Leo waits for his turn. One, two, three..."
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p4.mp3",
            "en": "assets/audio/en/stories/turn/p4.mp3"
          }
        },
        "image": "assets/stories/turn/page4.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Elif kaydı. Şimdi sıra Ali'de!",
            "en": "Elif went down the slide. Now it's Leo's turn!"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p5.mp3",
            "en": "assets/audio/en/stories/turn/p5.mp3"
          }
        },
        "image": "assets/stories/turn/page5.jpg"
      },
      {
        "line": {
          "text": {
            "tr": "Ali kaydı! Ali nasıl hissediyor?",
            "en": "Leo went down the slide! How does Leo feel?"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p6.mp3",
            "en": "assets/audio/en/stories/turn/p6.mp3"
          }
        },
        "choices": [
          {
            "image": "assets/stories/turn/choice_happy.png",
            "correct": true,
            "result": {
              "text": {
                "tr": "Evet, Ali çok mutlu.",
                "en": "Yes, Leo is very happy."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/turn/p6_happy.mp3",
                "en": "assets/audio/en/stories/turn/p6_happy.mp3"
              }
            }
          },
          {
            "image": "assets/stories/turn/choice_angry.png",
            "correct": false,
            "result": {
              "text": {
                "tr": "Bak, Ali gülüyor. Ali çok mutlu.",
                "en": "Look, Leo is laughing. Leo is very happy."
              },
              "audio": {
                "tr": "assets/audio/tr/stories/turn/p6_angry.mp3",
                "en": "assets/audio/en/stories/turn/p6_angry.mp3"
              }
            }
          }
        ]
      },
      {
        "line": {
          "text": {
            "tr": "Sırayla oynamak çok eğlenceli!",
            "en": "Taking turns is so much fun!"
          },
          "audio": {
            "tr": "assets/audio/tr/stories/turn/p7.mp3",
            "en": "assets/audio/en/stories/turn/p7.mp3"
          }
        },
        "image": "assets/stories/turn/page7.jpg"
      }
    ],
    "praise": {
      "text": {
        "tr": "Aferin sana! Sıra beklemeyi öğrendin.",
        "en": "Well done! You learned how to wait for your turn."
      },
      "audio": {
        "tr": "assets/audio/tr/stories/turn/praise.mp3",
        "en": "assets/audio/en/stories/turn/praise.mp3"
      }
    }
  },
  {
    "id": "doctor",
    "free": false,
    "title": {
      "tr": "Doktora gidiyorum",
      "en": "I go to the doctor"
    },
    "cover": "assets/stories/doctor/cover.png",
    "pages": [
      {
        "line": {
