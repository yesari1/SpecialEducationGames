rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    // A persistent server-only marker prevents another device (or an old token)
    // from recreating data while/after the account deletion worker runs.
    function canWriteFamily(uid) {
      return owner(uid) && !exists(/databases/$(database)/documents/deletionLocks/$(uid));
    }
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admin page (yesastudio.com): admins listed in admins/{uid}, which only
    // the Firebase console can write, may read and delete family data.
    function ownerOrAdmin(uid) { return owner(uid) || admin(); }
    function safeId(value) { return value is string && value.matches('^[A-Za-z0-9-]{1,128}$'); }
    function count(value) { return value is int && value >= 0; }
    function stamp(value) { return value is timestamp && value > timestamp.value(0) && value <= request.time; }
    function tier(value) { return value in ['easy', 'medium', 'hard']; }
    function exact(data, fields) { return data.keys().hasAll(fields) && data.keys().hasOnly(fields); }
    function calendarDay(value) {
      let parts = value.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      // Local calendar dates may be one day ahead of UTC, but never further.
      return day.year() == int(parts[0]) && day.month() == int(parts[1]) && day.day() == int(parts[2])
        && day <= request.time + duration.value(1, 'd');
    }
    function session(data, id) {
      return exact(data, ['date', 'themeId', 'modeId', 'difficulty', 'activeMs', 'rounds', 'stages', 'independent', 'updatedAt'])
        && data.date is string && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && calendarDay(data.date)
        && safeId(data.themeId) && safeId(data.modeId) && tier(data.difficulty)
        && count(data.activeMs) && count(data.rounds) && count(data.stages) && count(data.independent)
        && data.independent <= data.stages && stamp(data.updatedAt)
        && id == data.date + '_' + data.themeId + '_' + data.modeId + '_' + data.difficulty;
    }
    match /config/app {
      allow get: if true;
      allow list: if false;
      allow write: if admin();
    }
    function localizedText(text, maxLength) {
      return text is map && text.keys().hasOnly(['tr', 'en']) && text.keys().size() > 0
        && (!('tr' in text) || (text.tr is string && text.tr.size() > 0 && text.tr.size() <= maxLength))
        && (!('en' in text) || (text.en is string && text.en.size() > 0 && text.en.size() <= maxLength));
    }
    match /announcements/{id} {
      allow get: if safeId(id);
      allow list: if false;
      allow create, update: if admin() && safeId(id)
        && exact(request.resource.data, ['schemaVersion', 'title', 'body'])
        && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
        && localizedText(request.resource.data.title, 120)
        && localizedText(request.resource.data.body, 1200)
        && (('tr' in request.resource.data.title && 'tr' in request.resource.data.body)
          || ('en' in request.resource.data.title && 'en' in request.resource.data.body));
      allow delete: if admin();
    }
    // One free trial per Google account: the owner creates it once with the
    // server time; it is never changed or deleted by clients, so reinstalling
    // or another device cannot restart it.
    match /trials/{uid} {
      allow get: if ownerOrAdmin(uid);
      allow list: if admin();
      allow create: if owner(uid)
        && exact(request.resource.data, ['startedAt'])
        && request.resource.data.startedAt == request.time;
      allow update, delete: if false;
    }
    // Set by an admin on the admin page: a package given to the account
    // (premium until a date, or for good) and `endTrial`, which ends the
    // account's free trial early (back to the free games). The app only
    // reads its own.
    match /grants/{uid} {
      allow get: if ownerOrAdmin(uid);
      allow list, delete: if admin();
      allow create, update: if admin()
        && exact(request.resource.data, ['plan', 'until', 'endTrial', 'updatedAt'])
        && request.resource.data.plan in ['none', 'premium']
        && (request.resource.data.until == null || request.resource.data.until is timestamp)
        && request.resource.data.endTrial is bool
        && request.resource.data.updatedAt == request.time;
    }
    // Anonymous onboarding funnel: one document per install under a random
    // app-generated ID (no account, no device identifier, no child data).
    // Each step is stamped once with the server time and never changed.
    function step(name) {
      let had = resource != null && name in resource.data;
      return (had && name in request.resource.data && request.resource.data[name] == resource.data[name])
        || (!had && (!(name in request.resource.data) || request.resource.data[name] == request.time));
    }
    function funnelDoc() {
      let d = request.resource.data;
      return d.keys().hasAll(['installedAt', 'platform'])
        && d.keys().hasOnly(['installedAt', 'obChildAt', 'obFavoriteAt', 'obKnownAt', 'onboardingAt', 'signedInAt', 'paywallAt', 'freeAt', 'trialAt', 'purchasedAt', 'firstGameAt', 'reminderYesAt', 'reminderNoAt', 'platform', 'appVersion', 'locale', 'playMs', 'playDays', 'todayMs', 'playDate', 'fcmToken', 'uninstalledAt'])
        // The push address of this install; `uninstalledAt` only by the worker (kept as is).
        && (!('fcmToken' in d) || (d.fcmToken is string && d.fcmToken.size() > 0 && d.fcmToken.size() <= 512))
        && ((resource == null && !('uninstalledAt' in d))
          || (resource != null && d.get('uninstalledAt', null) == resource.data.get('uninstalledAt', null)))
        && d.platform in ['android', 'ios']
        // Play time on this install (also without an account), rewritten after each game.
        && (!('playMs' in d) || (d.playMs is int && d.playMs >= 0 && d.playMs <= 1000000000))
        && (!('playDays' in d) || (d.playDays is int && d.playDays >= 0 && d.playDays <= 10000))
        && (!('todayMs' in d) || (d.todayMs is int && d.todayMs >= 0 && d.todayMs <= 86400000))
        && (!('playDate' in d) || (d.playDate is string && d.playDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 32))
        && (!('locale' in d) || d.locale in ['tr', 'en'])
        && step('installedAt') && step('onboardingAt') && step('signedInAt')
        && step('paywallAt') && step('trialAt') && step('purchasedAt')
        && step('obChildAt') && step('obFavoriteAt') && step('obKnownAt')
        && step('freeAt') && step('firstGameAt')
        && step('reminderYesAt') && step('reminderNoAt');
    }
    match /funnel/{installId} {
      allow list: if admin();
      allow get: if false;
      allow create: if safeId(installId) && installId.size() >= 16 && funnelDoc();
      allow update: if funnelDoc();
      allow delete: if admin();
    }
    // Feedback a parent sends from the app settings. Create-only from the
    // app (signed in or not; an account field must match the sender); only
    // admins read it, mark it ('new' | 'read' | 'done') or delete it.
    function choiceId(v) { return v is string && v.matches('^[a-z0-9_]{1,40}$'); }
    function choiceIds(l) {
      return (l.size() < 1 || choiceId(l[0])) && (l.size() < 2 || choiceId(l[1]))
        && (l.size() < 3 || choiceId(l[2])) && (l.size() < 4 || choiceId(l[3]))
        && (l.size() < 5 || choiceId(l[4])) && (l.size() < 6 || choiceId(l[5]))
        && (l.size() < 7 || choiceId(l[6])) && (l.size() < 8 || choiceId(l[7]));
    }
    match /feedback/{id} {
      // A plain message (kind 'feedback', the default), or a short survey ('survey'): up to 8 ticked choice
      // IDs plus an optional message.
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt', 'uid', 'email', 'installId', 'appVersion', 'locale', 'platform'])
        && request.resource.data.keys().hasOnly(['message', 'createdAt', 'uid', 'email', 'installId', 'appVersion', 'locale', 'platform', 'kind', 'choices'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && (request.resource.data.get('kind', 'feedback') == 'feedback'
          ? (request.resource.data.message.size() >= 1 && !('choices' in request.resource.data))
          : (request.resource.data.kind == 'survey'
            && request.resource.data.choices is list && request.resource.data.choices.size() <= 8
            && (request.resource.data.choices.size() >= 1 || request.resource.data.message.size() >= 1)
            && choiceIds(request.resource.data.choices)))
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && (request.resource.data.email == null || (request.auth != null && request.resource.data.email == request.auth.token.email))
        && safeId(request.resource.data.installId)
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 32
        && request.resource.data.locale in ['tr', 'en']
        && request.resource.data.platform in ['android', 'ios'];
      allow read, delete: if admin();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'read', 'done'];
    }
    // Push notifications and e-mails written on the admin page; the
    // seg-notify worker (service account) sends them and fills the results.
    // `unsubscribes/{uid}` is written by the worker's unsubscribe link.
    match /campaigns/{id} {
      allow read, write: if admin();
    }
    match /emails/{id} {
      allow read, write: if admin();
    }
    match /unsubscribes/{uid} {
      allow read, delete: if admin();
      allow write: if false;
    }
    match /admins/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
    }
    match /families/{uid} {
      allow read, delete: if ownerOrAdmin(uid);
      allow create, update: if canWriteFamily(uid)
        && request.resource.data.keys().hasAll(['createdAt', 'locale', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['createdAt', 'locale', 'updatedAt', 'email', 'plan', 'lastSeenAt', 'appVersion', 'fcmToken', 'uninstalledAt'])
        && (!('fcmToken' in request.resource.data) || (request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() > 0 && request.resource.data.fcmToken.size() <= 512))
        // `uninstalledAt` is set only by the seg-notify worker; clients keep it as it is.
        && request.resource.data.get('uninstalledAt', null) == (resource == null ? null : resource.data.get('uninstalledAt', null))
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('plan' in request.resource.data) || request.resource.data.plan in ['free', 'trial', 'monthly', 'yearly', 'lifetime', 'granted'])
        && (!('lastSeenAt' in request.resource.data) || stamp(request.resource.data.lastSeenAt))
        && (!('appVersion' in request.resource.data) || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 32))
        && request.resource.data.locale in ['tr', 'en']
        && stamp(request.resource.data.createdAt) && stamp(request.resource.data.updatedAt);
      // Child profiles kept with the parent's account so they come back on a
      // new device: first name, age, avatar and a small settings map.
      match /children/{childId} {
        allow read, delete: if ownerOrAdmin(uid);
        allow create, update: if canWriteFamily(uid) && safeId(childId)
          && request.resource.data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['name', 'age', 'ageBand', 'avatarId', 'settings', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && (!('age' in request.resource.data) || (request.resource.data.age is int && request.resource.data.age >= 1 && request.resource.data.age <= 18))
          && (!('ageBand' in request.resource.data) || (request.resource.data.ageBand is string && request.resource.data.ageBand.size() <= 24))
          && (!('avatarId' in request.resource.data) || safeId(request.resource.data.avatarId))
          && (!('settings' in request.resource.data) || (request.resource.data.settings is map && request.resource.data.settings.size() <= 30))
          && stamp(request.resource.data.createdAt) && stamp(request.resource.data.updatedAt);
      }
      match /profiles/{profileId} {
        allow read, delete: if ownerOrAdmin(uid);
        allow create, update: if canWriteFamily(uid) && safeId(profileId)
          && exact(request.resource.data, ['nickname', 'avatarId', 'ageRange', 'survey', 'settings', 'createdAt', 'updatedAt'])
          && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 24
          && safeId(request.resource.data.avatarId)
          && request.resource.data.ageRange is string && request.resource.data.ageRange.size() <= 24
          && request.resource.data.survey is map && request.resource.data.settings is map
          && stamp(request.resource.data.createdAt) && stamp(request.resource.data.updatedAt);
        match /progress/{summaryId} {
          allow read, delete: if ownerOrAdmin(uid);
          allow create, update: if canWriteFamily(uid) && safeId(profileId)
            && exact(request.resource.data, ['themeId', 'modeId', 'difficulty', 'stages', 'independent', 'maxHint', 'updatedAt'])
            && safeId(request.resource.data.themeId) && safeId(request.resource.data.modeId) && tier(request.resource.data.difficulty)
            && count(request.resource.data.stages) && count(request.resource.data.independent)
            && request.resource.data.independent <= request.resource.data.stages
            && count(request.resource.data.maxHint) && request.resource.data.maxHint <= 4 && stamp(request.resource.data.updatedAt);
        }
        match /itemStats/{itemId} {
          allow read, delete: if ownerOrAdmin(uid);
          allow create, update: if canWriteFamily(uid) && safeId(profileId) && safeId(itemId)
            && exact(request.resource.data, ['correct', 'wrong', 'hintCounts', 'updatedAt'])
            && count(request.resource.data.correct) && count(request.resource.data.wrong)
            && request.resource.data.hintCounts is list && request.resource.data.hintCounts.size() == 5
            && count(request.resource.data.hintCounts[0]) && count(request.resource.data.hintCounts[1])
            && count(request.resource.data.hintCounts[2]) && count(request.resource.data.hintCounts[3])
            && count(request.resource.data.hintCounts[4]) && stamp(request.resource.data.updatedAt);
        }
        match /sessions/{summaryId} {
          allow read, delete: if ownerOrAdmin(uid);
          allow create, update: if canWriteFamily(uid) && safeId(profileId) && session(request.resource.data, summaryId);
        }
      }
    }
    // Admin page: collection-group reads across families.
    match /{path=**}/profiles/{id} { allow read: if admin(); }
    match /{path=**}/children/{id} { allow read: if admin(); }
    match /{path=**}/sessions/{id} { allow read: if admin(); }
    match /{path=**}/progress/{id} { allow read: if admin(); }
    match /{path=**}/itemStats/{id} { allow read: if admin(); }
    // Unspecified collections, including raw trial logs, are denied.
  }
}
